# vehicle-verification-api の環境変数サンプル
# EC2 上では /etc/vehicle-verification/app.env にコピーして値を書き換える(root:root 600)
# 本物の app.env はコミットしないこと
#
# 書式の注意(systemd の EnvironmentFile はシェルスクリプトではない)
# - KEY=VALUE の形式で1行に1つ。export は書けない
# - $VAR は展開されない
# - コメントは行頭の # のみ(行の途中の # は値の一部になる)
#
# AWSのアクセスキーは書かない。S3へはEC2に付けたIAMロールの認証情報で接続する

# プロファイル(prod: 添付ファイルをS3に保存)
SPRING_PROFILES_ACTIVE=prod

# DB接続情報(RDS)
SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-1.rds.amazonaws.com:3306/verification_db
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# JWT署名用の秘密鍵(32文字以上)
# 生成例: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# 初回起動時に作成される管理者ユーザー
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# 添付ファイルの保存先S3バケット
S3_BUCKET_NAME=change-me
S3_REGION=ap-northeast-1
