# これらの値を .env に書く（このフォルダかリポジトリ直下。.env は .gitignore 済み）
# このファイル自体には値を入れない（Git管理対象のひな形のため）
# 接続先。EC2 は起動のたびにIPが変わるので都度書き換える
BASE_URL=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# スモークテストで作る MEMBER ユーザーのパスワード（公開リポジトリに載せないため .env で渡す）
MEMBER_PASSWORD=
# 管理者用 パスワード再設定で使用する新しいパスワード
NEW_PASSWORD_FOR_ADMIN=
# MEMBER ユーザーの新しいパスワード（ログインユーザー本人用 パスワード再設定で使用する）
NEW_PASSWORD_FOR_MEMBER=